---
import '../styles/global.css';
import Header from '../components/Header.astro';
import NoticeBanner from '../components/NoticeBanner.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, buildAlternates, htmlLangAttr, getI18n } from '../i18n/ui';
import { ogLocale, siteConfig, attraction } from '../config';

interface Props {
  title: string;
  description: string;
  keywords?: string;
  path?: string;
}

const { title, description, keywords, path = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const htmlLang = htmlLangAttr(lang);
const alts = buildAlternates(path);
const canonical = alts[lang] ?? alts.zh;
const { messages } = getI18n(Astro.url);
const attractionName = attraction.fullName;
const absolute = (p: string) => (p.startsWith('http') ? p : `${siteConfig.baseUrl}${p}`);
const ogImageUrl = absolute(attraction.ogImage);
const keywordsContent = keywords ?? messages.meta?.keywords;

/**
 * 1. 结构化数据 (Schema.org / JSON-LD)
 * 向搜索引擎明确定义本页对应的地理实体（TouristAttraction）坐标与物理属性，
 * 并通过 @id / sameAs 与 Google 地图、泰国国家旅游局等权威节点建立实体关联。
 */
const jsonLd = {
  '@context': 'https://schema.org',
  // 同时声明为历史地标，覆盖「古城墙 / 历史景点」类查询意图
  '@type': ['TouristAttraction', 'HistoricalLandmark'],
  '@id': `${siteConfig.baseUrl}/#attraction`,
  name: attraction.fullName,
  alternateName: attraction.alternateNames,
  description: messages.meta.description,
  url: canonical,
  mainEntityOfPage: canonical,
  image: attraction.images.map(absolute),
  isAccessibleForFree: true,
  publicAccess: true,
  touristType: ['Culture', 'History', 'Photography', 'Sightseeing'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: attraction.streetAddress,
    addressLocality: attraction.city,
    addressRegion: attraction.province,
    postalCode: attraction.postalCode,
    addressCountry: attraction.countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: attraction.latitude,
    longitude: attraction.longitude,
  },
  hasMap: attraction.mapsShareUrl,
  // Plus Code / 坐标等定位信息以机器可读方式补充，匹配「coordinates」类查询
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Plus Code', propertyID: 'plusCode', value: attraction.plusCode },
    {
      '@type': 'PropertyValue',
      name: 'Coordinates',
      propertyID: 'coordinates',
      value: `${attraction.latitude}, ${attraction.longitude}`,
    },
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  ],
  isPartOf: {
    '@type': 'Place',
    name: attraction.oldCity,
    address: {
      '@type': 'PostalAddress',
      addressLocality: attraction.city,
      addressRegion: attraction.province,
      addressCountry: attraction.countryCode,
    },
  },
  containedInPlace: {
    '@type': 'Place',
    name: `${attraction.oldCity} walls and moat`,
    description:
      'The square moat and brick ramparts that define Chiang Mai Old City; Tha Phae Gate is the eastern entrance of this circuit.',
  },
  containsPlace: attraction.nearbyLandmarks.map((name) => ({
    '@type': 'TouristAttraction',
    name,
  })),
  offers: [
    {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'THB',
      url: canonical,
      description: messages.meta.description,
    },
  ],
  /**
   * 合规说明：此处刻意不输出 aggregateRating。
   * 页面展示的 4.4 / 29,638 属于 Google 地图使用者评价（第三方聚合评分），
   * 按 Google 评论摘要结构化数据政策，第三方平台的评分不得标记为本站自有评分，
   * 否则有被判定为垃圾结构化数据的风险。评分只在正文展示，并注明来源、同步时间与全部评价链接。
   * 若日后接入本站自有评价收集（站内留言评分），可在此恢复 aggregateRating。
   */
  sameAs: [attraction.mapsShareUrl, attraction.govtTourismUrl, attraction.municipalityUrl],
};

/** 站点实体：帮助搜索引擎将域名与景点实体绑定 */
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteConfig.baseUrl}/#website`,
  url: siteConfig.baseUrl,
  name: `${attraction.fullName} (${attraction.city}) Visitor Guide`,
  inLanguage: ['th', 'en', 'zh'],
  about: { '@id': `${siteConfig.baseUrl}/#attraction` },
  publisher: { '@id': `${siteConfig.baseUrl}/#attraction` },
  sameAs: [attraction.mapsShareUrl],
};

const breadcrumbLd = (() => {
  const bc = messages.breadcrumb;
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: bc.home, item: `${siteConfig.baseUrl}/${lang}` },
      { '@type': 'ListItem', position: 2, name: bc.region, item: `${siteConfig.baseUrl}/${lang}#overview` },
      { '@type': 'ListItem', position: 3, name: bc.city, item: `${siteConfig.baseUrl}/${lang}#transport` },
      { '@type': 'ListItem', position: 4, name: bc.current, item: canonical },
    ],
  };
})();
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordsContent && <meta name="keywords" content={keywordsContent} />}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content={attraction.themeColor} />

    <!-- Canonical 规范网址 -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh" href={alts.zh} />
    <link rel="alternate" hreflang="en" href={alts.en} />
    <link rel="alternate" hreflang="th" href={alts.th} />
    <link rel="alternate" hreflang="x-default" href={alts.xDefault} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={`${attraction.fullName} ${attraction.city}`} />
    <meta name="application-name" content={`${attraction.fullName} ${attraction.city}`} />

    <!-- Open Graph 社交标签 -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={`${attraction.fullName} (${attraction.city})`} />
    <meta property="og:locale" content={ogLocale[lang] ?? lang} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${attraction.fullName} in ${attraction.city}, ${attraction.country}`} />
    <meta property="og:image:width" content={String(attraction.ogImageWidth)} />
    <meta property="og:image:height" content={String(attraction.ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${attraction.fullName} in ${attraction.city}, ${attraction.country}`} />

    <meta name="google-adsense-account" content="ca-pub-XXXXXXXXXX" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script>

    <!-- Google Analytics 4 (gtag.js) -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${attraction.gaMeasurementId}`}></script>
    <script is:inline set:html={`window.dataLayer = window.dataLayer || []; function gtag(){dataLayer.push(arguments);} gtag('js', new Date()); gtag('config', '${attraction.gaMeasurementId}');`}></script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteLd)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>

    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        } catch (e) {}
      })();
    </script>

    <slot name="head" />
  </head>
  <body class="min-h-screen">
    <Header />
    <NoticeBanner />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
