---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.services;
const items = s.items ?? [];
---

<section id="services" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{s.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map((it) => (
        <article class="rounded-2xl p-6 border h-full flex flex-col" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl" aria-hidden="true">{it.icon}</span>
            <h3 class="font-semibold text-base" style="color: var(--text-primary);">{it.name}</h3>
          </div>

          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{it.detail}</p>

          {it.where && (
            <p class="text-xs mt-4" style="color: var(--text-muted);">
              <span class="font-medium">{s.whereLabel}：</span>{it.where}
            </p>
          )}

          {it.tip && (
            <p class="text-xs leading-relaxed mt-2 pt-2 border-t" style="color: var(--text-muted); border-color: var(--border-color);">
              💡 {it.tip}
            </p>
          )}
        </article>
      ))}
    </div>

    {s.neutralNote && (
      <p class="max-w-3xl mx-auto mt-8 text-xs leading-relaxed text-center" style="color: var(--text-muted);">{s.neutralNote}</p>
    )}
  </div>
</section>
