---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const l = messages.legends;
const stories = l.stories ?? [];
---

<section id="legends" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{l.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{l.subtitle}</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-5">
      {stories.map((st) => (
        <article class="rounded-3xl p-6 md:p-7 border h-full flex flex-col" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <p class="text-3xl mb-3" aria-hidden="true">{st.icon}</p>
          <h3 class="font-display text-xl font-semibold mb-1" style="color: var(--text-primary);">{st.title}</h3>
          {st.subtitle && (
            <p class="text-xs uppercase tracking-[0.18em] mb-4" style="color: var(--text-muted);">{st.subtitle}</p>
          )}

          <div class="space-y-3 text-sm leading-relaxed" style="color: var(--text-secondary);">
            {(st.paragraphs ?? []).map((p) => <p>{p}</p>)}
          </div>

          {st.evidence && (
            <p class="mt-auto pt-4 text-xs leading-relaxed border-t" style="color: var(--text-muted); border-color: var(--border-color);">
              <span class="font-medium">{l.evidenceLabel}：</span>{st.evidence}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
