---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config';
const { messages } = getI18n(Astro.url);
const r = messages.reviews;
const stars = (n) => Array.from({ length: 5 }, (_, i) => i < n ? 'star-filled' : 'star-empty');
const allReviewsUrl = r.allReviewsUrl ?? attraction.reviewsShareUrl;
const placeUrl = r.mapsUrl ?? attraction.mapsShareUrl;
const starCount = Math.round(parseFloat(r.rating ?? attraction.ratingValue));
---

<section id="reviews" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{r.title}</h2>
    <p class="text-center text-base mb-8" style="color: var(--text-secondary);">{r.subtitle}</p>

    <!-- 评分与来源（同步自 Google 地图用户评价） -->
    <div class="max-w-2xl mx-auto mb-10 rounded-2xl p-6 border text-center" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
      <div class="flex items-center justify-center gap-3 mb-2">
        <span class="text-4xl font-bold" style="color: var(--text-primary);">{r.rating}</span>
        <div class="flex gap-0.5 text-2xl">
          {stars(starCount).map((c) => <span class={c}>★</span>)}
        </div>
      </div>
      <p class="text-sm font-medium mb-3" style="color: var(--text-secondary);">{r.total}</p>
      <p class="text-xs leading-relaxed" style="color: var(--text-muted);">{r.sourceNote}</p>
      <div class="mt-4 flex flex-col sm:flex-row gap-3 justify-center">
        <a href={allReviewsUrl} target="_blank" rel="noopener noreferrer nofollow" class="text-sm font-semibold hover:opacity-70" style="color: var(--accent);">
          🔗 {r.sourceLinkLabel}
        </a>
      </div>
      {r.updatedLabel && <p class="mt-3 text-[11px]" style="color: var(--text-muted);">{r.updatedLabel}</p>}
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {r.items.map((item) => (
        <div class="rounded-2xl p-6 border" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-white" style="background: var(--accent);">
                {item.name.charAt(0)}
              </div>
              <div>
                <div class="font-semibold text-sm" style="color: var(--text-primary);">{item.name}</div>
                <div class="text-xs" style="color: var(--text-muted);">{item.date}</div>
              </div>
            </div>
            <div class="flex gap-0.5 text-lg sm:justify-end">
              {stars(item.rating).map((c) => <span class={c}>★</span>)}
            </div>
          </div>
          <p class="text-base leading-relaxed" style="color: var(--text-secondary);">{item.text}</p>
        </div>
      ))}
    </div>

    {r.itemsNote && (
      <p class="text-xs leading-relaxed mt-6 text-center max-w-3xl mx-auto" style="color: var(--text-muted);">{r.itemsNote}</p>
    )}

    <div class="text-center mt-10 flex flex-col sm:flex-row gap-3 justify-center">
      <a href={allReviewsUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn-cta btn-cta-primary">
        {r.cta}
      </a>
      <a href={placeUrl} target="_blank" rel="noopener noreferrer" class="btn-cta btn-cta-secondary">
        📍 {r.mapLabel}
      </a>
    </div>
  </div>
</section>
