---
import { guides, guideUi, type Locale } from '../data/guides';
import { getLangFromUrl } from '../i18n/ui';
const lang = getLangFromUrl(Astro.url) as Locale;
const ui = guideUi[lang];
const nearby = guides.filter(g => g.kind === 'place');
---
<section id="nearby-guides" class="section-padding" style="background:var(--bg-secondary);border-top:1px solid var(--border-color)">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
      <div><p class="text-sm uppercase tracking-widest mb-2" style="color:var(--accent)">Chiang Mai · Old City</p><h2 class="font-display text-3xl font-bold" style="color:var(--text-primary)">{ui.collection}</h2><p class="mt-3 max-w-2xl" style="color:var(--text-secondary)">{ui.intro}</p></div>
      <a class="rounded-xl px-5 py-3 border font-semibold hover:opacity-80" href={`/${lang}/guides/`} style="color:var(--accent);border-color:var(--accent)">{ui.back} →</a>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {nearby.map(g => <a href={`/${lang}/guides/${g.slug}/`} class="block p-5 rounded-2xl border hover:opacity-80" style="background:var(--card-bg);border-color:var(--border-color)"><h3 class="font-semibold text-lg" style="color:var(--text-primary)">{g.title[lang]}</h3><p class="text-sm mt-2 line-clamp-3" style="color:var(--text-secondary)">{g.focus[lang]}</p><span class="inline-block mt-4 text-sm font-semibold" style="color:var(--accent)">{ui.next} →</span></a>)}
    </div>
  </div>
</section>
