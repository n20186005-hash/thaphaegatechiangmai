---
import { getI18n } from '../i18n/ui';
const { lang } = getI18n(Astro.url);
const copy = {
  th: { name: 'ประตูท่าแพ', rights: 'สงวนลิขสิทธิ์', note: 'เว็บไซต์นี้เป็นโครงการข้อมูลท่องเที่ยวอิสระ และไม่มีความเกี่ยวข้องกับหน่วยงานรัฐบาลหรือองค์กรทางการใด ๆ' },
  en: { name: 'Tha Phae Gate', rights: 'All rights reserved.', note: 'This website is an independent travel information project. We are not affiliated with any government agency or official organization.' },
  zh: { name: '塔佩门', rights: '版權所有。', note: '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联。' },
}[lang] ?? { name: 'Tha Phae Gate', rights: 'All rights reserved.', note: 'This website is an independent travel information project.' };
---

<footer class="section-padding" style="background:var(--bg-tertiary);border-top:1px solid var(--border-color)">
  <div class="max-w-6xl mx-auto px-4 text-sm space-y-2" style="color:var(--text-secondary)">
    <p>© 2026 {copy.name} · {copy.rights}</p>
    <p>{copy.note}</p>
  </div>
</footer>
