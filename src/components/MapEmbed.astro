---
import { getI18n } from '../i18n/ui';
import { attraction } from '../config';
const { messages } = getI18n(Astro.url);
const m = messages.mapSection;
const embedUrl = m.mapsEmbedSrc ?? attraction.mapsEmbedSrc;
const s = messages.sources ?? {};
---

<section id="map" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{m.title}</h2>
    <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{m.subtitle}</p>

    <div class="map-container overflow-hidden border" style="border-color: var(--map-border);">
      <iframe
        src={embedUrl}
        class="w-full h-[320px] sm:h-[420px]"
        width="100%"
        height="450"
        style="border:0;"
        loading="lazy"
        allowfullscreen
        referrerpolicy="strict-origin-when-cross-origin"
        title={`${attraction.fullName} (${attraction.city}) - Google Maps`}
      ></iframe>
    </div>

    <div class="text-center mt-8 flex flex-wrap justify-center gap-3">
      <a href={m.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold text-white" style="background: var(--accent);">
        📍 {m.openMaps}
      </a>
      <a
        href={`https://www.google.com/maps/dir/?api=1&destination=${attraction.latitude},${attraction.longitude}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex w-full sm:w-auto justify-center px-8 py-3 rounded-full font-semibold border"
        style="border-color: var(--accent); color: var(--accent);"
      >
        🧭 {m.directionsCta}
      </a>
    </div>

    <!-- 精确定位：坐标 / Plus Code / 步行提示，直接命中“坐标、怎么走”类搜索需求 -->
    <h3 class="font-display text-xl font-semibold mt-10 mb-4 text-center" style="color: var(--text-primary);">{m.coordinatesTitle}</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="rounded-2xl border px-5 py-4 text-center" style="border-color: var(--map-border); background: var(--card-bg);">
        <p class="text-xs uppercase tracking-[0.16em] mb-1" style="color: var(--text-muted);">{m.coordsLabel}</p>
        <p class="font-mono text-lg" style="color: var(--text-primary);">{attraction.latitude}, {attraction.longitude}</p>
      </div>
      <div class="rounded-2xl border px-5 py-4 text-center" style="border-color: var(--map-border); background: var(--card-bg);">
        <p class="text-xs uppercase tracking-[0.16em] mb-1" style="color: var(--text-muted);">{m.plusCodeLabel}</p>
        <p class="font-mono text-lg" style="color: var(--text-primary);">{attraction.plusCode}</p>
      </div>
    </div>
    <p class="text-sm mt-4 text-center leading-relaxed" style="color: var(--text-secondary);">{m.walkNote}</p>

    <!-- 权威 .org / .go.th 外链 -->
    {s.portalText && (
      <p class="text-center text-sm mt-8 leading-relaxed" style="color: var(--text-secondary);">
        {s.portalText}{' '}
        <a href={attraction.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="underline font-medium hover:opacity-70" style="color: var(--accent);">
          {s.portalLink ?? attraction.govtTourismUrl}
        </a>.
      </p>
    )}
  </div>
</section>
